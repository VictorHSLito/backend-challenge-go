# Local example values only.

# Database Configuration
POSTGRES_USER=wager-admin
POSTGRES_PASSWORD=wager-admin
POSTGRES_DB=wager_db
DATABASE_URL=postgres://wager-admin:wager-admin@localhost:5432/wager_db?sslmode=disable

# OIDC (Keycloak)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://localhost:8180/realms/wager
# Only needed when the API cannot reach OIDC_ISSUER_URL directly (e.g. inside
# Docker Compose, where Keycloak is at http://keycloak:8080 on the network but
# tokens still carry iss=http://localhost:8180/...). Leave empty when running
# the API on your host.
OIDC_DISCOVERY_URL=
OIDC_AUDIENCE=wager-api
OIDC_INTERNAL_ROLE=internal

# SQS (LocalStack)
AWS_REGION=us-east-1
SQS_ACCESS_KEY_ID=wager-app
SQS_SECRET_ACCESS_KEY=wager-app-secret
AWS_ACCESS_KEY_ID=wager-app
AWS_SECRET_ACCESS_KEY=wager-app-secret
SQS_ENDPOINT=http://localhost:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo